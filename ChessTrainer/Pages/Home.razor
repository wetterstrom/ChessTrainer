@page "/"
@using ChessDotNet
@using ChessTrainer.Components
@using ChessTrainer.Core.Interfaces
@using ChessTrainer.Core.Models
@using ChessTrainer.Services
@inject GameHistoryManager History
@inject LichessApiClient LichessClient
@inject IChessEvaluationService EvalService
@inject IOpponentStrategy OpponentAi
@inject GameReviewService ReviewService
@inject IJSRuntime JS
@inject ChessDotComApiClient ChessDotComClient

<PageTitle>ChessTrainer – Lichess & Maia</PageTitle>

<div class="trainer-container" tabindex="0" @onkeydown="HandleKeyDown" style="outline: none;">
    <header class="trainer-header">
        <div class="brand">♟️ ChessTrainer</div>
        <div class="mode-tabs">
            <button type="button" class="tab-btn @(ActiveMode == AppMode.PlayMaia ? "active" : "")"
                    @onclick="() => SwitchMode(AppMode.PlayMaia)">🤖 Spela mot Maia</button>
            <button type="button" class="tab-btn @(ActiveMode == AppMode.MyGames ? "active" : "")"
                    @onclick="() => SwitchMode(AppMode.MyGames)">📚 Mina Lichess-partier</button>
        </div>
    </header>

    <div class="main-workspace">
        <!-- Vänster: Brädet -->
        <div class="board-section">
            @if (!string.IsNullOrEmpty(GameOverMessage) && !IsRunningReview && ReviewSummary == null)
            {
                <div class="game-over-banner">
                    <h3>🏆 @GameOverMessage</h3>
                    <button class="action-btn secondary" @onclick="RunFullGameReviewAsync">🔍 Kör Game Review</button>
                </div>
            }

            @if (IsRetryMode)
            {
                <div class="retry-banner">
                    <h3>🧩 Taktikläge</h3>
                    <p>@RetryFeedback</p>
                    <button class="action-btn" style="background: #fff; color: #ca3431;" @onclick="ExitRetryMode">Avbryt</button>
                </div>
            }

            <div class="eval-bar-container @(IsBoardFlipped ? "flipped" : "")" title="Vinstchans Vit: @(CurrentEval.WhiteWinPercentage.ToString("0"))%">
                <div class="eval-bar-white" style="height: @(CurrentEval.WhiteWinPercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                <span class="eval-score-label @(CurrentEval.WhiteWinPercentage >= 50 ? "score-dark" : "score-light")">
                    @(IsEvaluating ? "..." : CurrentEval.FormattedScore)
                </span>
            </div>

            <ChessBoard Fen="@History.Current.Fen"
                        IsFlipped="@IsBoardFlipped"
                        LastMoveUci="@History.Current.MovePlayedUci"
                        LastMoveQuality="@History.Current.Quality"
                        HintUci="@CurrentEval.BestMoveUci"
                        HintLevel="@HintStep"
                        ArrowPlayedUci="@GetArrowPlayedUci()"
                        ArrowBestUci="@GetArrowBestUci()"
                        OnMovePlayed="HandleUserMoveAsync" />
        </div>

        <!-- Höger: Panel -->
        <div class="side-panel">
            <div class="panel-card status-card">
                <div class="status-row"><span class="label">Ställning:</span><strong class="value">@GetWinningSummary()</strong></div>
                <div class="status-row"><span class="label">Material:</span><strong class="value">@History.Current.Material.AdvantageText</strong></div>
            </div>

            <div class="panel-card tools-card">
                <div class="btn-group">
                    <button type="button" class="action-btn hint-btn" @onclick="RequestHint" disabled="@IsBusy">
                        💡 @(HintStep == 0 ? "Tips" : HintStep == 1 ? "Visa pjäs" : $"Bäst: {CurrentEval.BestMoveUci}")
                    </button>

                    @if (ActiveMode == AppMode.PlayMaia)
                    {
                        <button type="button" class="action-btn" @onclick="UndoMovePairAsync" disabled="@(History.CurrentIndex < (PlayerIsWhite ? 1 : 2) || IsBusy)">↩️ Ångra</button>
                    }
                    <button type="button" class="action-btn secondary" @onclick="FlipBoard">🔄 Vänd</button>
                </div>
            </div>

            <!-- Chess.com Game Review Panel -->
            <div class="panel-card review-card">
                <div class="review-header">
                    <h4>📊 Game Review</h4>
                    <button type="button" class="action-btn" @onclick="RunFullGameReviewAsync"
                            disabled="@(History.Timeline.Count <= 1 || IsRunningReview)">
                        @(IsRunningReview ? $"Analyserar ({ReviewProgress}/{History.Timeline.Count - 1})..." : "🔍 Analysera parti")
                    </button>
                </div>

                @if (History.Timeline.Count > 1)
                {
                    <div class="nav-controls" style="margin-top: 0; margin-bottom: 0.65rem;">
                        <button type="button" class="action-btn secondary" @onclick="() => NavigateHistory(0)">⏮</button>
                        <button type="button" class="action-btn secondary" @onclick="StepBackwardAsync">◀ Bakåt</button>
                        <span class="move-counter">Drag @(History.CurrentIndex) / @(History.Timeline.Count - 1)</span>
                        <button type="button" class="action-btn secondary" @onclick="StepForwardAsync">Framåt ▶</button>
                        <button type="button" class="action-btn secondary" @onclick="() => NavigateHistory(History.Timeline.Count - 1)">⏭</button>
                    </div>
                }

                @if (ReviewSummary is not null)
                {
                    <!-- UTVÄRDERINGSGRAF (CHESS.COM STIL) -->
                    <div class="eval-graph-container" title="Partiets utvärderingsgraf">
                        @foreach (var wp in ReviewSummary.WhiteWinPercentages)
                        {
                            <div class="eval-graph-bar @(wp < 40 ? "black-winning" : "")"
                                 style="height: @(Math.Clamp(wp, 5, 95))%;"></div>
                        }
                    </div>

                    <!-- PRECISION / ACCURACY BOX -->
                    <div class="accuracy-box">
                        <div class="acc-col">
                            <span class="acc-label">♔ Vit Precision</span>
                            <span class="acc-score white-acc">@ReviewSummary.White.Accuracy%</span>
                        </div>
                        <div class="acc-col">
                            <span class="acc-label">♚ Svart Precision</span>
                            <span class="acc-score black-acc">@ReviewSummary.Black.Accuracy%</span>
                        </div>
                    </div>

                    <!-- CHESS.COM STATISTIKTABELL -->
                    <div class="review-stats-table">
                        <div class="review-stats-header">
                            <span>Färdigheter</span>
                            <span>♔</span>
                            <span>♚</span>
                        </div>

                        @foreach (var q in new[] {
                            MoveQuality.Brilliant, MoveQuality.Great, MoveQuality.Best,
                            MoveQuality.Excellent, MoveQuality.Good, MoveQuality.Book,
                            MoveQuality.Inaccuracy, MoveQuality.Mistake, MoveQuality.Blunder })
                        {
                            var meta = q.GetMeta();
                            int wCount = ReviewSummary.White.Counts[q];
                            int bCount = ReviewSummary.Black.Counts[q];
                            if (wCount > 0 || bCount > 0 || q is MoveQuality.Brilliant or MoveQuality.Mistake or MoveQuality.Blunder)
                            {
                                <div class="review-stats-row">
                                    <div class="stat-label-group">
                                        <span class="quality-dot" style="background: @meta.ColorHex">@meta.Badge</span>
                                        <span>@meta.Title</span>
                                    </div>
                                    <span style="color: @meta.ColorHex">@wCount</span>
                                    <span style="color: @meta.ColorHex">@bCount</span>
                                </div>
                            }
                        }
                    </div>

                    <button class="action-btn full-width" style="margin-bottom: 0.75rem; background: #e6912c; color: #fff;" @onclick="StartMistakeRetry">
                        🧩 Spela om dina misstag
                    </button>

                    <div class="move-strip">
                        @for (int i = 1; i < History.Timeline.Count; i++)
                        {
                            int idx = i;
                            var snap = History.Timeline[i];
                            var meta = snap.Quality.GetMeta();
                            <button type="button" class="move-chip @(History.CurrentIndex == idx ? "active" : "")"
                                    @onclick="() => NavigateHistory(idx)">
                                @if (idx % 2 == 1)
                                {
                                    <small>@((idx + 1) / 2).</small>
                                }
                                <span>@(snap.MovePlayedSan ?? snap.MovePlayedUci)</span>
                                @if (snap.Quality != MoveQuality.None)
                                {
                                    <span class="chip-badge" style="color: @meta.ColorHex">@meta.Badge</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Maia Inställningar -->
            @if (ActiveMode == AppMode.PlayMaia)
            {
                <div class="panel-card">
                    <h4>Mänsklig Sparring (Maia-stil)</h4>
                    <div class="setting-row">
                        <select @bind="TargetMaiaRating" @bind:after="SaveSettingsAsync" class="input-select">
                            <option value="1100">Maia ~1100</option>
                            <option value="1500">Maia ~1500</option>
                            <option value="1900">Maia ~1900</option>
                        </select>
                    </div>
                    <div class="setting-row">
                        <div class="color-selector">
                            <button type="button" class="color-btn @(SelectedColorChoice == ColorChoice.White ? "active" : "")" @onclick="() => SelectedColorChoice = ColorChoice.White">♔ Vit</button>
                            <button type="button" class="color-btn @(SelectedColorChoice == ColorChoice.Random ? "active" : "")" @onclick="() => SelectedColorChoice = ColorChoice.Random">🎲 Slump</button>
                            <button type="button" class="color-btn @(SelectedColorChoice == ColorChoice.Black ? "active" : "")" @onclick="() => SelectedColorChoice = ColorChoice.Black">♚ Svart</button>
                        </div>
                    </div>
                    <button type="button" class="action-btn full-width" @onclick="StartNewMaiaGameAsync" disabled="@IsBusy">▶️ Starta nytt parti</button>
                </div>
            }

            <!-- Läge 2: Mina partier (Lichess / Chess.com) -->
            @if (ActiveMode == AppMode.MyGames)
            {
                <div class="panel-card">
                    <h4>Hämta dina partier</h4>

                    <div class="setting-row" style="margin-bottom: 0.5rem;">
                        <div class="color-selector">
                            <button type="button" class="color-btn @(SelectedPlatform == "lichess" ? "active" : "")"
                                    @onclick='() => SelectedPlatform = "lichess"'>
                                ♟️ Lichess
                            </button>
                            <button type="button" class="color-btn @(SelectedPlatform == "chesscom" ? "active" : "")"
                                    @onclick='() => SelectedPlatform = "chesscom"'>
                                ♞ Chess.com
                            </button>
                        </div>
                    </div>

                    <div class="search-row">
                        <input class="input-text" placeholder="@(SelectedPlatform == "lichess" ? "Lichess-användarnamn..." : "Chess.com-användarnamn...")" @bind="LichessUsername" />
                        <button type="button" class="action-btn" @onclick="FetchUserGamesAsync" disabled="@IsLoadingGames">
                            @(IsLoadingGames ? "Laddar..." : "Hämta")
                        </button>
                    </div>

                    @if (UserGames.Count > 0)
                    {
                        <div class="games-list">
                            @foreach (var g in UserGames)
                            {
                                <div class="game-item @(SelectedGameId == g.Id ? "active" : "")"
                                     @onclick="() => LoadSelectedGameAsync(g)">
                                    <div><strong>@g.WhiteName</strong> vs <strong>@g.BlackName</strong></div>
                                    <small>@(g.Opening?.Name ?? "Okänd öppning") • @g.PlayedDate.ToString("yyyy-MM-dd")</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private enum AppMode { PlayMaia, MyGames }
    private AppMode ActiveMode = AppMode.PlayMaia;
    private enum ColorChoice { White, Random, Black }
    private ColorChoice SelectedColorChoice = ColorChoice.White;
    private bool PlayerIsWhite = true;

    private int TargetMaiaRating = 1500;
    private bool IsBoardFlipped = false;
    private bool IsBusy = false;
    private bool IsEvaluating = false;
    private int HintStep = 0;

    private string LichessUsername = "";
    private bool IsLoadingGames = false;
    private string? SelectedGameId;
    private List<LichessGameDto> UserGames = [];
    private LichessExplorerResponseDto? OpeningStats;

    private GameReviewSummary? ReviewSummary;
    private bool IsRunningReview = false;
    private int ReviewProgress = 0;

    private string GameOverMessage = "";
    private bool IsRetryMode = false;
    private int RetryMistakeIndex = -1;
    private string RetryFeedback = "";
    private string SelectedPlatform = "lichess";

    private EvaluationResult CurrentEval => History.Current.Evaluation ?? new EvaluationResult();

    protected override async Task OnInitializedAsync()
    {
        var savedUser = await JS.InvokeAsync<string?>("localStorage.getItem", "chess_lichess_user");
        if (!string.IsNullOrWhiteSpace(savedUser)) LichessUsername = savedUser;

        var savedRating = await JS.InvokeAsync<string?>("localStorage.getItem", "chess_maia_rating");
        if (int.TryParse(savedRating, out int parsedRating)) TargetMaiaRating = parsedRating;

        await RefreshEvaluationAsync();
    }

    private string? GetArrowPlayedUci()
    {
        if (IsRetryMode || History.CurrentIndex == 0) return null;
        var q = History.Current.Quality;
        return (q is MoveQuality.Mistake or MoveQuality.Blunder or MoveQuality.Inaccuracy) ? History.Current.MovePlayedUci : null;
    }

    private string? GetArrowBestUci()
    {
        if (IsRetryMode || History.CurrentIndex == 0) return null;
        var q = History.Current.Quality;
        return (q is MoveQuality.Mistake or MoveQuality.Blunder or MoveQuality.Inaccuracy) ? History.Timeline[History.CurrentIndex - 1].Evaluation?.BestMoveUci : null;
    }

    private void CheckGameOver()
    {
        var game = new ChessGame(History.Current.Fen);
        if (game.IsWinner(Player.White)) GameOverMessage = "Schackmatt! Vit vinner.";
        else if (game.IsWinner(Player.Black)) GameOverMessage = "Schackmatt! Svart vinner.";
        else if (game.IsDraw()) GameOverMessage = "Remi! Partiet är oavgjort.";
        else GameOverMessage = "";
    }

    private void StartMistakeRetry()
    {
        for (int i = 1; i < History.Timeline.Count; i++)
        {
            if (History.Timeline[i].Quality is MoveQuality.Mistake or MoveQuality.Blunder)
            {
                IsRetryMode = true;
                RetryMistakeIndex = i;
                RetryFeedback = "Hitta det bästa draget som räddar ställningen!";
                History.JumpToMove(i - 1); // Hoppa till ställningen PRECIS INNAN misstaget
                return;
            }
        }
    }

    private void ExitRetryMode()
    {
        IsRetryMode = false;
        History.JumpToMove(History.Timeline.Count - 1);
    }

    private async Task SaveSettingsAsync()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "chess_lichess_user", LichessUsername.Trim());
        await JS.InvokeVoidAsync("localStorage.setItem", "chess_maia_rating", TargetMaiaRating.ToString());
    }

    private async Task SwitchMode(AppMode mode)
    {
        ActiveMode = mode;
        HintStep = 0;
        if (mode == AppMode.PlayMaia) await StartNewMaiaGameAsync();
    }

    private async Task StartNewMaiaGameAsync()
    {
        if (IsBusy) return;
        IsBusy = true; HintStep = 0; ReviewSummary = null; GameOverMessage = ""; IsRetryMode = false;

        try
        {
            History.Reset();
            PlayerIsWhite = SelectedColorChoice switch { ColorChoice.White => true, ColorChoice.Black => false, _ => Random.Shared.Next(2) == 0 };
            IsBoardFlipped = !PlayerIsWhite;
            StateHasChanged();

            if (!PlayerIsWhite)
            {
                var game = new ChessGame(History.Current.Fen);
                string botMoveUci = await OpponentAi.GetNextMoveUciAsync(History.Current.Fen, TargetMaiaRating);
                if (ChessMoveParser.TryApplyUciMove(game, botMoveUci, out string afterBotFen, out string appliedBotUci))
                {
                    History.RecordMove(afterBotFen, appliedBotUci, appliedBotUci);
                }
            }
            await RefreshEvaluationAsync();
        }
        finally { IsBusy = false; }
    }

    private async Task HandleUserMoveAsync(string uciMove)
    {
        if (IsBusy) return;
        IsBusy = true; HintStep = 0;

        try
        {
            if (IsRetryMode)
            {
                var correctUci = History.Timeline[RetryMistakeIndex - 1].Evaluation?.BestMoveUci;
                if (string.Equals(uciMove, correctUci, StringComparison.OrdinalIgnoreCase))
                {
                    RetryFeedback = "Snyggt! Du hittade rätt drag.";
                    IsRetryMode = false; // Lämna taktikläget när du hittat rätt
                }
                else
                {
                    RetryFeedback = "Tyvärr, det var inte det bästa draget. Prova igen!";
                }
                return;
            }

            var game = new ChessGame(History.Current.Fen);
            if (!ChessMoveParser.TryApplyUciMove(game, uciMove, out string newFen, out string appliedUci)) return;

            History.RecordMove(newFen, appliedUci, appliedUci);
            CheckGameOver();
            StateHasChanged();

            if (ActiveMode == AppMode.PlayMaia && string.IsNullOrEmpty(GameOverMessage))
            {
                string botMoveUci = await OpponentAi.GetNextMoveUciAsync(newFen, TargetMaiaRating);
                if (ChessMoveParser.TryApplyUciMove(game, botMoveUci, out string afterBotFen, out string appliedBotUci))
                {
                    History.RecordMove(afterBotFen, appliedBotUci, appliedBotUci);
                    CheckGameOver();
                }
            }
            await RefreshEvaluationAsync();
        }
        finally { IsBusy = false; }
    }

    private async Task RunFullGameReviewAsync()
    {
        if (IsRunningReview || History.Timeline.Count <= 1) return;
        IsRunningReview = true; ReviewProgress = 0;

        try
        {
            ReviewSummary = await ReviewService.AnalyzeFullGameAsync(History, (current, total) =>
            {
                ReviewProgress = current;
                InvokeAsync(StateHasChanged);
            });
        }
        finally { IsRunningReview = false; StateHasChanged(); }
    }

    private async Task UndoMovePairAsync()
    {
        HintStep = 0; GameOverMessage = ""; IsRetryMode = false;
        History.TakebackMovePair();
        await RefreshEvaluationAsync();
    }

    private void RequestHint() { HintStep = HintStep < 2 ? HintStep + 1 : 1; }

    private async Task FetchUserGamesAsync()
    {
        if (string.IsNullOrWhiteSpace(LichessUsername)) return;
        IsLoadingGames = true;
        try
        {
            await SaveSettingsAsync();
            if (SelectedPlatform == "chesscom")
            {
                UserGames = await ChessDotComClient.GetUserGamesAsync(LichessUsername, 15);
            }
            else
            {
                UserGames = await LichessClient.GetUserGamesAsync(LichessUsername, 15);
            }
        }
        finally
        {
            IsLoadingGames = false;
        }
    }

    private async Task LoadSelectedGameAsync(LichessGameDto gameDto)
    {
        SelectedGameId = gameDto.Id; HintStep = 0; ReviewSummary = null; GameOverMessage = ""; IsRetryMode = false;
        IsBoardFlipped = string.Equals(gameDto.BlackName, LichessUsername.Trim(), StringComparison.OrdinalIgnoreCase);
        ChessMoveParser.LoadSanMovesIntoHistory(gameDto.Moves, History);
        await RefreshEvaluationAsync();
    }

    private async Task StepBackwardAsync() { HintStep = 0; History.StepBackward(); await RefreshEvaluationAsync(); }
    private async Task StepForwardAsync() { HintStep = 0; History.StepForward(); await RefreshEvaluationAsync(); }
    private async Task NavigateHistory(int index) { HintStep = 0; History.JumpToMove(index); await RefreshEvaluationAsync(); }

    private async Task RefreshEvaluationAsync()
    {
        if (History.Current.Evaluation is not null) return;
        IsEvaluating = true; StateHasChanged();
        try
        {
            var eval = await EvalService.EvaluatePositionAsync(History.Current.Fen);
            History.AttachEvaluationToCurrent(eval);
        }
        finally { IsEvaluating = false; StateHasChanged(); }
    }

    private string GetWinningSummary()
    {
        double winPct = CurrentEval.WhiteWinPercentage;
        return winPct switch
        {
            >= 70 => $"Vit har vinnande ställning ({CurrentEval.FormattedScore})",
            >= 56 => $"Vit står något bättre ({CurrentEval.FormattedScore})",
            <= 30 => $"Svart har vinnande ställning ({CurrentEval.FormattedScore})",
            <= 44 => $"Svart står något bättre ({CurrentEval.FormattedScore})",
            _ => $"Jämn ställning ({CurrentEval.FormattedScore})"
        };
    }

    private void FlipBoard() { IsBoardFlipped = !IsBoardFlipped; }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "f", StringComparison.OrdinalIgnoreCase)) FlipBoard();
        else if (e.Key == "ArrowLeft" && History.CanStepBackward && !IsBusy) await StepBackwardAsync();
        else if (e.Key == "ArrowRight" && History.CanStepForward && !IsBusy) await StepForwardAsync();
    }
}